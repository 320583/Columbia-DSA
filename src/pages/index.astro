---
import Link from '@/components/link.astro'
// TEMPORARILY-DISABLE-NEWS-FEED: imports below are only used by the "Latest posts"
// section, which is commented out until blog/news content is ready to be
// public again. Re-enable alongside the section below.
// import BlogCard from '@/components/blog-card.astro'
import PageHead from '@/components/page-head.astro'
// import { buttonVariants } from '@/components/ui/button'
// import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
// import { getRecentPosts } from '@/lib/data-utils'

// const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="rounded-lg border">
    <div class="flex items-start gap-4 p-6">
      <img
        src="/static/dsa-logo.png"
        alt="Columbia DSA logo"
        width="400"
        height="400"
        class="hidden h-20 w-20 shrink-0 rounded-lg sm:block sm:h-24 sm:w-24"
      />
      <div class="flex flex-col">
        <!-- TEMPORARILY-DISABLE-HEADING: "Columbia DSA" heading hidden next to the new logo. Restore if the heading should come back. -->
        <!-- <h3 class="text-3xl leading-none font-medium mb-1.5">Columbia DSA</h3> -->
        <p class="mb-2 text-sm font-bold">
          Welcome to the Columbia, SC Chapter of the Democratic Socialists of America.
        </p>
        <p class="mb-2 text-sm">
          We're building a leftist movement in the Midlands of South Carolina.
        </p>
        <p class="mb-2 text-sm">
          The Democratic Socialists of America is the largest socialist organization in the United States because we’re a member-driven mass organization. We believe that working people should run both the economy and civil society, and we show our commitment to this principle by being an organization of, by, and for the working class.
        </p>
        <p class="text-sm">
          <Link
            href="https://docs.google.com/forms/d/e/1FAIpQLSfHvwVl_9pAdQEpJ5smm_GWY9O-q3AQyx6C_orgZnQHTHZfiw/viewform"
            external
            class="font-semibold underline underline-offset-4"
          >
            Get Involved
          </Link>
        </p>
      </div>
    </div>
  </section>
  <!--
    TEMPORARILY-DISABLE-JOIN-BANNER: "Join DSA Today" banner removed from
    the homepage for now. The downloaded image is still at
    public/static/join-dsa-banner.png — restore this <img> if/when the
    banner should come back.

  <img
    src="/static/join-dsa-banner.png"
    alt="Join DSA Today — we believe that working people should run both the economy and society democratically to meet human needs, not to make profits for a few."
    width="2000"
    height="750"
    class="w-full rounded-lg"
  />
  -->
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Event Calendar</h2>
    <div class="relative min-h-[600px] overflow-hidden rounded-[20px] bg-white shadow-sm dark:bg-slate-950/70">
      <div
        id="calendar-loader"
        class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-white/80 dark:bg-slate-950/80 text-center backdrop-blur-sm"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-full border-4 border-slate-950/25 dark:border-white/25 border-t-slate-950 dark:border-t-white animate-spin" />
        <p class="mt-4 text-sm text-slate-950 dark:text-slate-100">Loading calendar…</p>
      </div>

      <!--
        The calendar should always look light, in every browser,
        regardless of the site's own toggle or the OS setting. Google's
        embed has no dark mode of its own, so in most browsers (Chrome,
        Firefox, etc.) that's already the default with no CSS needed.
        Safari is the one exception: it automatically applies its own
        dark-adaptation to iframed content that declares `color-scheme:
        light` whenever the OS is in dark mode, regardless of what we
        want. The `@supports (hanging-punctuation: first) and (font:
        -apple-system-body)` check below is a well-known Safari-only CSS
        feature-detection hack, used here to counter-invert the iframe
        back to light ONLY in Safari AND only when the OS is dark --
        everywhere else this does nothing. Note: Safari's own adaptation
        isn't a plain color invert, so this counter-invert doesn't
        perfectly cancel it -- it may still look slightly dim/washed-out
        in that one case (Safari + OS dark mode), but it stays in the
        light family rather than flipping fully dark.
      -->
      <style is:global>
        @supports (hanging-punctuation: first) and (font: -apple-system-body) {
          @media (prefers-color-scheme: dark) {
            .gcal-embed {
              filter: invert(1) hue-rotate(180deg) saturate(1.1) contrast(0.9);
            }
          }
        }
      </style>

      <!-- Mobile: Agenda view -->
      <iframe
        src="https://calendar.google.com/calendar/embed?height=600&amp;wkst=1&amp;ctz=America%2FNew_York&amp;src=dsaofcolumbia%40gmail.com&amp;mode=AGENDA&amp;color=%23a79b8e"
        class="gcal-embed block md:hidden w-full min-h-[600px] bg-white"
        style="border-radius: 20px; border: 0;"
        width="100%"
        height="600"
        onload="document.getElementById('calendar-loader').style.display='none'"
      ></iframe>

      <!-- Desktop: Month view -->
      <iframe
        src="https://calendar.google.com/calendar/embed?height=600&amp;wkst=1&amp;ctz=America%2FNew_York&amp;src=dsaofcolumbia%40gmail.com&amp;mode=MONTH&amp;color=%23a79b8e"
        class="gcal-embed hidden md:block w-full min-h-[600px] bg-white"
        style="border-radius: 20px; border: 0;"
        width="100%"
        height="600"
        onload="document.getElementById('calendar-loader').style.display='none'"
      ></iframe>
    </div>
  </section>
  <!--
    TEMPORARILY-DISABLE-NEWS-FEED: "Latest posts" section and the "See all
    posts" link to /blog are hidden while blog/news content is being kept
    out of public view. The /blog routes themselves are also disabled (see
    src/pages/_blog). Restore this section and the imports above together
    when news content is ready to be public again.

  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Latest posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
  -->
</Layout>
