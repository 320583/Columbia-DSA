---
import { SITE } from '@/consts'
import { ClientRouter } from 'astro:transitions'
import Favicons from './favicons.astro'
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />

  <!--
    Search engines are allowed to index this site (noindex/nofollow
    removed). The directives below are intentionally kept: they don't
    block indexing, they specifically discourage archiving/caching
    (Google/Bing's cached-copy feature, and web archive crawlers like the
    Wayback Machine -- see public/robots.txt for the actual crawl block).
  -->
  <meta name="robots" content="noarchive, nocache" />
  <meta name="googlebot" content="noarchive" />
  <meta name="bingbot" content="noarchive" />
  <meta name="ia_archiver" content="noarchive" />
  <meta name="archive" content="no" />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />

  <meta
    name="theme-color"
    content="#121212"
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content="#121212"
    media="(prefers-color-scheme: light)"
  />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <!--
    TEMPORARILY-DISABLE-NEWS-FEED: the RSS feed (src/pages/_rss.xml.ts) is
    disabled along with the rest of the blog/news content. Restore when
    news content is ready to be public again.

  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL('rss.xml', Astro.site)}
  />
  -->

  <Favicons />
  <ClientRouter />

  <slot />
</head>
